pkgname=reelcut
pkgver=0.4.1
pkgrel=1
pkgdesc='Make vertical reels for Instagram, Facebook, YouTube Shorts and TikTok: cut, caption, color, music'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'ffmpeg' 'xdg-desktop-portal' 'noto-fonts' 'ttf-liberation' 'opencv')
optdepends=('whisper-cpp: automatic captions')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/reelcut "$pkgdir/usr/bin/reelcut"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/reelcut.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/reelcut.svg"
  install -Dm644 "$startdir/reelcut.desktop" "$pkgdir/usr/share/applications/reelcut.desktop"
}
